# ============================================================
# CM.AI backend configuration (Spring Boot reads this file on startup)
# Real environment variables override anything in here.
# Copy to .env and fill in the blanks.
# ============================================================

PORT=8000
APP_ENV=development
FRONTEND_URL=http://localhost:5173

# --- Cookie flags -----------------------------------------------------------
# Local dev (Vite proxy, same site):  false / Lax
# Production (frontend and API on different domains, HTTPS):  true / None
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax

# --- MySQL (replaces MongoDB) ----------------------------------------------
# These are NOT from your old project - set them for your MySQL server.
# `docker compose up -d` in this folder starts a matching MySQL using DB_PASSWORD.
DB_URL=jdbc:mysql://localhost:3306/cmai?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=
# update = Hibernate creates/updates tables automatically. Use `validate` once your schema is stable.
DDL_AUTO=update

# --- Redis (your existing Upstash instance, now via the Redis protocol over TLS) ---
REDIS_URL=

# --- Groq (used by BOTH Spring AI and LangChain4j) ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- YouTube Data API ---
YOUTUBE_BASE_URL=https://www.googleapis.com/youtube/v3/search
YOUTUBE_API_KEY=

# --- Razorpay ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Firebase Admin ---
FIREBASE_PROJECT_ID=cmai-ffc7e
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# --- Pricing ---
# 0 = server does not charge (frontend calls /api/auth/use-coins). Set e.g. 50 to charge server-side.
INTERVIEW_COIN_COST=0
